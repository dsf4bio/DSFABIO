{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/assistenaza.html",
      "destination": "/assistenza",
      "permanent": true
    },
    {
      "source": "/assistenaza",
      "destination": "/assistenza",
      "permanent": true
    },
    {
      "source": "/assitenzagestionale.html",
      "destination": "/assistenzagestionale",
      "permanent": true
    },
    {
      "source": "/assitenzagestionale",
      "destination": "/assistenzagestionale",
      "permanent": true
    },
    {
      "source": "/:lang(en|de|es|fr|pt)/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/prova-gratis",
      "destination": "https://dsmenu.it/",
      "permanent": true
    },
    {
      "source": "/prova-gratis.html",
      "destination": "https://dsmenu.it/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/paga",
      "destination": "https://xzhbyxvlrxemujrqatbl.supabase.co/functions/v1/paga"
    }
  ],
  "headers": [
    {
      "source": "/((?!mdc-)(?!demo-).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(mdc-|demo-)(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://dsmenu.it https://www.dsmenu.it"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
